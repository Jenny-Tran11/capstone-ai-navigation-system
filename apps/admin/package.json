{
  "name": "@baseline/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy:staging": "./scripts/deploy.sh staging",
    "remove:staging": ". ../../scripts/project-variables.sh && npx serverless remove --stage staging --region $REGION",
    "deploy:prod": "./scripts/deploy.sh prod",
    "remove:prod": ". ../../scripts/project-variables.sh && npx serverless remove --stage prod --region $REGION",
    "aws:profile": "../../scripts/setup-aws-profile.sh",
    "start": "npx vite",
    "build": "pnpm run generate:env:staging && npx vite build",
    "build:deploy": "npx vite build",
    "preview": "npx vite preview",
    "generate:env:local": "pnpm -w run generate:env:local",
    "generate:env:staging": "pnpm -w run generate:env:staging",
    "generate:env:prod": "pnpm -w run generate:env:prod",
    "lint": "npx eslint 'src/**/*.{ts,tsx,jsx,js}'",
    "pretty": "npx prettier --write 'src/**/*.{ts,tsx,js,json,css,md,yml,yaml,html}' && npx prettier --write 'public/**/*.{ts,tsx,js,json,css,md,yml,yaml,html}' && npx prettier --write '*.{ts,tsx,js,json,css,md,yml,yaml,html}'"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "6.5.5",
    "@baseline/client-api": "workspace:1.0.0",
    "@baseline/types": "workspace:1.0.0",
    "@baseline/ui": "workspace:1.0.0",
    "@heroicons/react": "^2.2.0",
    "@tabler/icons-react": "3.26.0",
    "@tailwindcss/vite": "4.1.4",
    "@vitejs/plugin-react": "4.3.4",
    "aws-amplify": "6.6.6",
    "axios": "1.7.7",
    "next-themes": "^0.4.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet": "6.1.0",
    "react-router-dom": "6.22.3",
    "react-select": "5.8.0",
    "tailwindcss": "4.1.4",
    "typescript": "5.4.2",
    "vite": "5.4.14",
    "vite-plugin-environment": "1.1.3"
  },
  "devDependencies": {
    "@types/react": "18.2.67",
    "@types/react-dom": "18.2.22",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "postcss": "8.5.1",
    "prettier": "2.4.1",
    "serverless": "3.40.0",
    "serverless-baseline-invalidate-cloudfront": "0.1.2",
    "serverless-s3-sync": "3.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
