{
  "name": "@baseline/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "aws:profile": "../../scripts/setup-aws-profile.sh",
    "start": "npx vite",
    "build": "if [ \"${SKIP_GENERATE_ENV:-}\" != \"1\" ]; then pnpm run generate:env:staging; fi && npx vite build",
    "build:deploy": "npx vite build",
    "preview": "npx vite preview",
    "generate:env:local": "pnpm -w run generate:env:local",
    "generate:env:staging": "pnpm -w run generate:env:staging",
    "generate:env:prod": "pnpm -w run generate:env:prod"
  },
  "dependencies": {
    "@baseline/client-api": "workspace:1.0.0",
    "@baseline/types": "workspace:1.0.0",
    "@baseline/ui": "workspace:1.0.0",
    "@tailwindcss/vite": "4.1.4",
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet-async": "2.0.5",
    "react-router-dom": "6.22.3",
    "tailwindcss": "4.1.4",
    "typescript": "5.4.2",
    "vite": "5.4.14",
    "vite-plugin-environment": "1.1.3"
  },
  "devDependencies": {
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "postcss": "8.5.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
