# Local API: http://localhost:4000/  (trailing slash matches api-client default)
# EAS Build does not read this file on Expo's servers — set the same keys in EAS Dashboard
# or eas.json env / secrets for release APKs. See docs/mobile-deployment-prd-and-uat.md

EXPO_PUBLIC_API_URL=http://localhost:4000/

# Local model API example: http://localhost:8080 (no trailing slash for detect base URL)
# Production example: https://detect.example.com
EXPO_PUBLIC_DETECT_API_URL=
EXPO_PUBLIC_DETECT_API_KEY=

# Optional: crossing service (falls back to EXPO_PUBLIC_DETECT_API_KEY if unset)
EXPO_PUBLIC_CROSSING_API_URL=
EXPO_PUBLIC_CROSSING_API_KEY=

# Roboflow workflow example: https://serverless.roboflow.com/<workspace>/workflows/<workflow-id>

EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_AWS_REGION=ap-southeast-2

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_AI_API_KEY=
EXPO_PUBLIC_GOOGLE_AI_MODEL=gemini-2.0-flash
