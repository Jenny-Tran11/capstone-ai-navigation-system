# Local API example: http://localhost:4000/  (trailing slash matches api-client)
# EAS Build does not read this file on Expo's servers — set the same keys in EAS Dashboard
# or eas.json env / secrets for release APKs. See docs/mobile-deployment-prd-and-uat.md
#
# If unset, the app uses the default staging API Gateway URL in `api-client.ts`.
# Set this when developing against a local API.
EXPO_PUBLIC_API_URL=http://localhost:4000/

# Local model API example: http://localhost:8080 (no trailing slash for detect base URL)
# Production example: https://detect.example.com
# Required for obstacle detection in release builds (no bundled model.tflite by default).
EXPO_PUBLIC_DETECT_API_URL=
EXPO_PUBLIC_DETECT_API_KEY=

# Optional: crossing service (falls back to EXPO_PUBLIC_DETECT_API_KEY if unset)
EXPO_PUBLIC_CROSSING_API_URL=
EXPO_PUBLIC_CROSSING_API_KEY=

# Roboflow workflow example: https://serverless.roboflow.com/<workspace>/workflows/<workflow-id>

EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_AWS_REGION=ap-southeast-2

# Used by walking directions (Routes API) on the device. Home/onboarding address search
# uses the API (server-side key from app config / GOOGLE_MAPS_API_KEY on Lambda).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_AI_API_KEY=
EXPO_PUBLIC_GOOGLE_AI_MODEL=gemini-2.0-flash

# Local native build (expo prebuild + ./gradlew): set ANDROID_HOME to your Android SDK,
# or create android/local.properties with: sdk.dir=/path/to/Android/sdk
# macOS default: ~/Library/Android/sdk
#
# Gradle: use JDK 17 or 21 locally (JDK 24+ breaks react-native-worklets CMake). Or:
#   ./apps/mobile/scripts/android-gradle.sh assembleRelease
