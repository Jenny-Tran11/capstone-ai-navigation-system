# Copy to .env (do not commit .env).

# --- Detection API (REST, API key) ---
# Stage root URL, e.g. https://xxxxx.execute-api.ap-southeast-2.amazonaws.com/prod
EXPO_PUBLIC_DETECT_API_URL=
EXPO_PUBLIC_DETECT_API_KEY=

# --- User API (HTTP API v2, JWT) — from BlindNavUserApiStack outputs ---
EXPO_PUBLIC_USER_API_URL=
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
# Issuer: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
EXPO_PUBLIC_COGNITO_ISSUER=
EXPO_PUBLIC_AWS_REGION=
