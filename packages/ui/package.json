      "default": "./src/primitives/*.ts"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./globals.css": "./src/globals.css",
    "./package.json": "./package.json"
  },
