{
  "name": "@baseline/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./primitives/*": {
      "types": "./src/primitives/*.tsx",
      "import": "./src/primitives/*.tsx",
      "default": "./src/primitives/*.tsx"
